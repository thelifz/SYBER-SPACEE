# ==============================================================================
# SYBER SPACE SECURITY SYSTEMS — ENVIRONMENT CONFIGURATION
# Production Backend & HDFC Bank SmartGateway™ Payment Gateway Integration
# ==============================================================================

# Server Network Configuration
PORT=5500
NODE_ENV=production
APP_URL=https://syberspace.in

# ------------------------------------------------------------------------------
# HDFC BANK SMARTGATEWAY™ / SMARTHUB COMMERCIAL CREDENTIALS
# (Fill these in once received from your HDFC Merchant Account Relationship Manager)
# ------------------------------------------------------------------------------
# Environment: 'sandbox' (for UAT testing) or 'production' (for live transactions)
HDFC_ENV=sandbox

# HDFC Merchant Identifier (MID)
HDFC_MERCHANT_ID=HDFC_MERCHANT_SYBER_0808

# HDFC Terminal Identifier (TID)
HDFC_TERMINAL_ID=88102941

# HDFC SmartGateway API Key / Client ID
HDFC_API_KEY=test_api_key_syberspace_2026

# HDFC Working Key / Secret Salt (used for HMAC-SHA256 signature verification)
HDFC_WORKING_KEY=test_working_key_syberspace_sec_0808

# HDFC Merchant Virtual Payment Address (VPA for Direct UPI Dynamic QR)
HDFC_MERCHANT_VPA=syberspace@hdfcbank

# Callback & Webhook URLs (must match URLs registered with HDFC)
HDFC_RETURN_URL=https://syberspace.in/cart.html
HDFC_WEBHOOK_URL=https://syberspace.in/api/hdfc/webhook

# Business Support Email & Phone
MERCHANT_SUPPORT_EMAIL=info@syberspace.in
MERCHANT_SUPPORT_PHONE=+917511180808
